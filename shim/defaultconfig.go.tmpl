package defaults

import (
	"reflect"

	cfg "${SERVICE_MODULE}/${CONFIG_PACKAGE}"
	svcdefaults "${SERVICE_MODULE}/${DEFAULTS_PACKAGE}"
)

// FullDefaultConfig is the entrypoint the OpenCloud docs generator expects on
// every service. Delegates to the real default-config builder so reflection
// walks the genuine yaml/env/desc tags on the Config struct.
//
// If the Config has a shared.Commons field, it is zeroed so reflection doesn't
// surface env vars inherited from *shared.Commons (tagged yaml:"-") that the
// service does not intentionally expose. Services without a Commons field are
// left untouched, so this compiles and works whether or not the field exists.
func FullDefaultConfig() *cfg.Config {
	c := svcdefaults.FullDefaultConfig()
	if f := reflect.ValueOf(c).Elem().FieldByName("Commons"); f.IsValid() && f.CanSet() {
		f.Set(reflect.Zero(f.Type()))
	}
	return c
}
